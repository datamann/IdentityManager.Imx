{
  "name": "imxweb",
  "version": "10.0.0",
  "private": true,
  "description": "Public facing IMX workspace - Angular + NX monorepo",
  "engines": {
    "node": "^26.13.1",
    "yarn": "Please use npm instead of yarn to install dependencies",
    "pnpm": "Please use npm instead of pnpm to install dependencies"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "start:remote-dev": "ng serve -c remote-dev",
    "start:remote-qs": "ng serve -c remote-qs",
    "build": "ng build",
    "nx:build": "npx nx build",
    "nx:build-ci": "npx nx run-many -t build --configuration production",
    "build:watch": "ng build --watch --configuration development",
    "nx:build-all": "npx nx run-many -t build",
    "build:production": "npx nx build --configuration production",
    "postinstall": "node docker/prepare-packages.mjs && node scripts/patch-nx-angular.mjs",
    "test": "ng test --code-coverage --browsers Chrome",
    "test-ci": "ng test --code-coverage --browsers ChromeHeadless --watch=false",
    "nx:test-ci": "npx nx run-many -t test --code-coverage --browsers ChromeHeadless --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "ng e2e",
    "doc": "node scripts/build-docs.js"
  },
  "scriptsComments": {
    "start": "Runs a development server for <app> on localhost:4200. e.g npm run start <app>",
    "build": "Directly uses the angular compiler to build a single project. e.g npm run build <project>",
    "nx:build": "Uses Nx to build all dependencies before the specified project. e.g npm run nx:build <project>",
    "nx:build-ci": "Builds all projects in workspace with production configuration for a CI system.",
    "nx:test-ci": "Tests all projects in workspace.",
    "build:watch": "Directly uses the angular compiler to build-watch a single project. e.g",
    "build:production": "Use Nx to build a production ready project.",
    "postinstall": "Resolves bundled OIM packages without removing lockfile entries and applies the pinned Nx/Angular Architect compatibility patch.",
    "test": "Tests a single project. e.g. npm run test <project>",
    "doc": "Runs the build-doc.js script against <projects> to apply compodoc to any given project. e.g. npm run doc <project1> <project2>"
  },
