map $http_x_forwarded_proto $public_scheme {
    default $scheme;
    http http;
    https https;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

# The API decodes OAuth state before returning Module and code to Angular.
map $arg_state $oauth_callback {
    '' 0;
    default 1;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 0;

    # Docker's embedded DNS resolves API hosts when a request is made.
    resolver 127.0.0.11 valid=30s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    location = / {
        # Keep the callback on the portal origin, but let the API process it.
        error_page 418 = @api;
        if ($oauth_callback) {
            return 418;
        }
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /appconfig.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # Angular bundles and lazy chunks live at the application root.
    location ~ ^/[^/]+\.(js|css|map|ico|woff2?|ttf|svg|txt)$ {
        try_files $uri =404;
    }

    # Angular uses hash routing. Backend routes, including /html/ links to
    # other Identity Manager applications, are forwarded to the API server.
    location / {
        try_files $uri @api;
    }

    location @api {
        # A variable URI preserves the original method, body and escaped URL,
        # while prepending an optional API virtual directory.
        proxy_pass ${API_SERVER_URL}$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host ${API_SERVER_AUTHORITY};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $public_scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_ssl_server_name on;
        proxy_ssl_name ${API_SERVER_HOST};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 5;
        proxy_ssl_trusted_certificate ${API_SERVER_CA_BUNDLE};

        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;

        proxy_cookie_domain ~. $host;
        proxy_cookie_path ~^/.* /;
        proxy_redirect ~^${API_SERVER_URL_PATTERN}(/.*)?$ $public_scheme://$http_host$1;
        proxy_redirect ${API_SERVER_PATH}/ $public_scheme://$http_host/;
    }
}
